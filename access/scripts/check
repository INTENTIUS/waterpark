#!/usr/bin/env bash
# Everything a PR job would run over access/, in the order it runs it.
#
#   access/scripts/check              the whole stack, in the order CI runs it
#   access/scripts/check lint         just tflint over the real roots
#   access/scripts/check fixtures     just the rule fixtures
#   access/scripts/check codeowners   just the generated CODEOWNERS comparison
#   access/scripts/check workflow     just the fork-PR property over the workflow
#   access/scripts/check plan         just the credential-free plan against Floci
#
# One option, and it changes what a non-empty plan means.
#
#   access/scripts/check --plan-mode ci
#
# The same command runs in the editor, from an agent and in CI, and produces
# the same diagnostic. That is prescription 4.
set -uo pipefail

access_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$access_root" || exit 1

export TFLINT_OPA_POLICY_DIR="$access_root/.tflint.d/policies"
tflint_config="$access_root/.tflint.hcl"

# The Terraform roots and modules the checks cover. envs/dev is a README
# until a lesson needs it. identity and github are live only and are checked
# here on every run, because a rule that is not checked is a rule that has
# already drifted.
roots=(
	envs/prod
	identity
	github
	baseline
	modules/persona
)

# Satellite roots. A satellite is a sibling root under access/ (decision 49)
# and it gets the same checks as central, because the delegation contract is
# worth nothing if the satellite runs a weaker one. A satellite joins this
# list by existing.
for d in satellites/*/; do
	[ -f "${d}versions.tf" ] && roots+=("${d%/}")
done

# rule directory under tests/fixtures : the Rego function that implements it.
# The function-name prefix is the severity, deny_ for an error and warn_ for a
# warning, so promoting a rule is a one-word edit in the policy plus a line
# here (decision 9).
rules=(
	"one-type-per-file:deny_one_type_per_file"
	"path-matches-name:deny_path_matches_name"
	"no-wildcard-action:deny_no_wildcard_action"
	"no-inline-policy:deny_no_inline_policy"
	"no-iam-user-or-group:deny_no_iam_user_or_group"
	"tag-owner-required:deny_tag_owner_required"
	"boundary-required:deny_boundary_required"
	"no-open-ingress:warn_no_open_ingress"
	"sg-reference-not-cidr:warn_sg_reference_not_cidr"
)

failures=0

say() { printf '%s\n' "$*"; }

fail() {
	printf 'FAIL  %s\n' "$*"
	failures=$((failures + 1))
}

ok() { printf 'ok    %s\n' "$*"; }

run_fmt() {
	say "== terraform fmt"
	if terraform fmt -check -recursive . >/dev/null; then
		ok "every .tf under access/ is formatted"
	else
		terraform fmt -check -recursive .
		fail "terraform fmt -check. Run: terraform fmt -recursive access"
	fi
}

run_validate() {
	say "== terraform validate"
	for root in "${roots[@]}"; do
		if ! terraform -chdir="$root" init -backend=false -input=false -no-color >/dev/null 2>&1; then
			fail "terraform init in access/$root"
			continue
		fi
		if terraform -chdir="$root" validate -no-color >/dev/null; then
			ok "access/$root"
		else
			terraform -chdir="$root" validate -no-color
			fail "terraform validate in access/$root"
		fi
	done
}

# tflint over one directory. Errors fail, warnings are reported and do not.
run_lint() {
	say "== tflint"
	for root in "${roots[@]}"; do
		out="$(tflint --chdir="$root" --config="$tflint_config" \
			--minimum-failure-severity=error --format=compact 2>&1)"
		code=$?
		[ -n "$out" ] && printf '%s\n' "$out"
		if [ "$code" -eq 0 ]; then
			ok "access/$root"
		else
			fail "tflint in access/$root"
		fi
	done
}

# Every rule has a failing and a passing fixture, and each pair is checked
# with only that one rule enabled.
run_fixtures() {
	say "== rule fixtures"
	for entry in "${rules[@]}"; do
		rule="${entry%%:*}"
		fn="${entry##*:}"
		id="opa_$fn"
		sev="error"
		case "$fn" in
		warn_*) sev="warning" ;;
		esac

		before="$failures"
		for outcome in fail pass; do
			dir="tests/fixtures/$rule/$outcome"
			if [ ! -d "$dir" ]; then
				fail "$rule has no $outcome fixture"
				continue
			fi
			tflint --chdir="$dir" --config="$tflint_config" --only="$id" \
				--minimum-failure-severity=notice --format=compact >/dev/null 2>&1
			code=$?
			if [ "$outcome" = fail ] && [ "$code" -eq 0 ]; then
				fail "$rule ($sev) did not fire on its failing fixture"
			elif [ "$outcome" = pass ] && [ "$code" -ne 0 ]; then
				tflint --chdir="$dir" --config="$tflint_config" --only="$id" \
					--minimum-failure-severity=notice --format=compact
				fail "$rule ($sev) fired on its passing fixture"
			fi
		done
		[ "$failures" -eq "$before" ] && ok "$rule ($sev)"
	done
}

# CODEOWNERS is generated, not authored (decision 21). This stage is what
# makes that true rather than aspirational, because a hand edit to the routing
# is otherwise the quietest possible way to change who approves access.
run_codeowners() {
	say "== generated CODEOWNERS"
	if "$access_root/scripts/gen-codeowners" --check; then
		ok ".github/CODEOWNERS matches the principal files"
	else
		fail ".github/CODEOWNERS was hand edited or a principal file moved"
	fi
}

# Prescription 6's test, as a grep rather than as a promise. A fork PR must
# not be able to reach a credentialed job, and there are exactly two ways this
# workflow could stop being true: a job that runs on pull_request naming a
# secret, or one asking for id-token: write to federate into a cloud.
#
# The reading is deliberately blunt. Any job that is not gated to push is
# treated as reachable from a pull request, because that is what GitHub does.
run_workflow() {
	say "== the fork-PR property"
	local wf="$access_root/../.github/workflows/access.yml"
	if [ ! -f "$wf" ]; then
		fail "no .github/workflows/access.yml to check"
		return
	fi

	if ! sed -n '/^on:/,/^[a-z]/p' "$wf" | grep -q 'pull_request'; then
		ok "the workflow does not run on pull_request at all"
		return
	fi

	# Split into job blocks. A job key sits at two spaces under jobs:, and its
	# block runs to the next one.
	local blocks
	blocks="$(awk '
		/^jobs:/ { injobs = 1; next }
		injobs && /^[^[:space:]#]/ { injobs = 0 }
		injobs && /^  [a-zA-Z0-9_-]+:/ { name = $1; sub(/:$/, "", name); print "@@job@@" name }
		injobs { print }
	' "$wf")"

	local job="" gated=0 bad=0 seen=0
	local line
	while IFS= read -r line; do
		case "$line" in
		"@@job@@"*)
			job="${line#@@job@@}"
			gated=0
			seen=$((seen + 1))
			continue
			;;
		esac
		case "$line" in
		*"github.event_name == 'push'"*) gated=1 ;;
		esac
		if [ "$gated" -eq 0 ] && [ -n "$job" ]; then
			case "$line" in
			*'secrets.'*)
				fail "job $job runs on pull_request and names a secret"
				bad=1
				;;
			*'id-token:'*'write'*)
				fail "job $job runs on pull_request and asks for id-token: write"
				bad=1
				;;
			esac
		fi
	done <<EOF
$blocks
EOF

	if [ "$seen" -eq 0 ]; then
		fail "could not read any job out of .github/workflows/access.yml"
		return
	fi
	[ "$bad" -eq 0 ] && ok "no job reachable from pull_request names a secret or asks to federate"
}

floci_endpoint="${FLOCI_ENDPOINT:-http://localhost:4566}"

# The plan a PR job runs. It reaches Floci and no cloud, so it holds no
# credential, which is the half of prescription 6 lesson 4 closes. Skipped
# with a line rather than a failure when Floci is not up, because the rest of
# the stack is still worth running.
run_plan() {
	say "== terraform plan against Floci"
	if [ "$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$floci_endpoint/" 2>/dev/null)" = "000" ]; then
		say "skip  Floci is not answering on $floci_endpoint. Start it with:"
		say "      docker run -d --name wp-access-floci -p 4566:4566 \\"
		say "        -e FLOCI_SERVICES_IAM_ENFORCEMENT_ENABLED=true \\"
		say "        ghcr.io/lex00/floci:iam-boundary"
		return
	fi

	# envs/prod first, then every satellite, because a satellite reads the
	# central boundary live and cannot plan before central has applied it.
	planned=(envs/prod)
	for d in satellites/*/; do
		[ -f "${d}versions.tf" ] && planned+=("${d%/}")
	done

	for root in "${planned[@]}"; do
		terraform -chdir="$root" init -input=false -no-color >/dev/null 2>&1
		terraform -chdir="$root" plan -detailed-exitcode -input=false -no-color >/dev/null 2>&1
		case $? in
		0) ok "$root matches the account, exit 0" ;;
		2)
			if [ "$plan_mode" = ci ]; then
				ok "$root plans the change this branch proposes, exit 2"
			else
				fail "$root has an unapplied diff. Run terraform -chdir=access/$root plan"
			fi
			;;
		*) fail "terraform plan against Floci errored in $root" ;;
		esac
	done
}

# What a plan that is not empty means depends on the account it ran against.
#
#   laptop   the default. Floci already holds the applied estate, so a diff is
#            something nobody applied and the stage fails until it is applied.
#   ci       the account is a service container this job filled from the base
#            branch, so a diff is exactly the change the pull request proposes.
#            The stage records it and stays green. Binding that change to an
#            approval is the digest step's job, not this one's.
#
# Set with --plan-mode ci or ACCESS_PLAN_MODE=ci.
plan_mode="${ACCESS_PLAN_MODE:-laptop}"

while [ $# -gt 0 ]; do
	case "$1" in
	--plan-mode)
		plan_mode="${2:-}"
		shift 2 || true
		;;
	--plan-mode=*)
		plan_mode="${1#--plan-mode=}"
		shift
		;;
	*) break ;;
	esac
done

case "$plan_mode" in
laptop | ci) ;;
*)
	echo "check: unknown --plan-mode $plan_mode. It is laptop or ci." >&2
	exit 2
	;;
esac

case "${1:-all}" in
fmt) run_fmt ;;
validate) run_validate ;;
lint) run_lint ;;
fixtures) run_fixtures ;;
codeowners) run_codeowners ;;
workflow) run_workflow ;;
plan) run_plan ;;
all)
	run_fmt
	run_validate
	run_lint
	run_fixtures
	run_codeowners
	run_workflow
	run_plan
	;;
*)
	echo "usage: access/scripts/check [--plan-mode laptop|ci] [all|fmt|validate|lint|fixtures|codeowners|workflow|plan]" >&2
	exit 2
	;;
esac

say
if [ "$failures" -eq 0 ]; then
	say "check passed"
	exit 0
fi
say "check failed, $failures problem(s)"
exit 1
