#!/usr/bin/env bash
# Emit .github/CODEOWNERS from the principal files it routes.
#
#   access/scripts/gen-codeowners           write .github/CODEOWNERS
#   access/scripts/gen-codeowners --check   exit 1 if the committed file differs
#   access/scripts/gen-codeowners --stdout  print it and write nothing
#
# CODEOWNERS is generated, not authored (decision 21). Adding a principal
# reroutes its review with no dotfile edit, and a hand edit shows up as a diff
# in the next check rather than as a quiet change to who approves access.
#
# Two sources, and they do not overlap. A principal file routes to the teams
# it names, mapped to GitHub handles through access/codeowners.map. The
# guardrail paths route to platform by rule, because the things that decide
# what the estate may be are not a team's to change.
set -uo pipefail

access_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo_root="$(cd "$access_root/.." && pwd)"
cd "$access_root" || exit 1

map_file="$access_root/codeowners.map"
out_file="$repo_root/.github/CODEOWNERS"

# The guardrail path. Whoever owns these decides what every other file is
# allowed to say, so they are platform's by rule rather than by a tag anyone
# can edit. The generator's own inputs are on the list, which is the point.
guardrail_paths=(
	"/access/baseline/**"
	"/access/.tflint.d/**"
	"/access/scripts/**"
	"/access/codeowners.map"
	"/access/github/**"
	"/.github/workflows/access.yml"
	"/.github/CODEOWNERS"
)
guardrail_owner="@INTENTIUS/platform"

die() {
	printf 'gen-codeowners: %s\n' "$*" >&2
	exit 1
}

[ -f "$map_file" ] || die "no team map at access/codeowners.map"

# team name -> handle, read once.
handle_for() {
	local team="$1" line
	line="$(grep -E "^[[:space:]]*${team}:" "$map_file" | head -1)"
	[ -n "$line" ] || return 1
	printf '%s\n' "${line#*:}" | tr -d ' \t'
}

# The teams a leaf file names, one per line. A file with no teams line owns
# itself by the guardrail rule below and is reported rather than skipped.
teams_in() {
	sed -n 's/^[[:space:]]*teams[[:space:]]*=[[:space:]]*\[\(.*\)\].*/\1/p' "$1" |
		head -1 | tr ',' '\n' | tr -d ' "' | grep -v '^$'
}

# Every file that declares a principal, in a stable order. envs/<env> and any
# satellite hold workloads, identity/ holds humans.
principal_files() {
	{
		find envs -name 'iam_role.*.tf' -type f 2>/dev/null
		find satellites -name 'iam_role.*.tf' -type f 2>/dev/null
		find identity -name 'ssoadmin_permission_set.*.tf' -type f 2>/dev/null
	} | LC_ALL=C sort
}

render() {
	cat <<'HEADER'
# Generated by access/scripts/gen-codeowners. Do not edit.
#
# Review routing is derived from the principal files it routes (decision 21).
# A team named in a leaf file becomes a GitHub handle through
# access/codeowners.map, so adding a principal reroutes its review with no
# edit here, and an edit here is a diff the checks fail on.
#
# Regenerate with:
#
#   access/scripts/gen-codeowners
#
# Later rules win in CODEOWNERS, so the guardrail block at the bottom is the
# one that decides the guardrail path whatever a principal file says.

HEADER

	printf '# Principals, routed to the teams their leaf files name.\n'
	local f owners team handle missing=0
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		owners=""
		while IFS= read -r team; do
			[ -n "$team" ] || continue
			if ! handle="$(handle_for "$team")"; then
				printf 'gen-codeowners: %s names team %q, which access/codeowners.map does not map\n' "$f" "$team" >&2
				missing=1
				continue
			fi
			owners="$owners $handle"
		done < <(teams_in "$f")

		if [ -z "$owners" ]; then
			printf 'gen-codeowners: %s names no team. Add a teams list, or the file routes to nobody\n' "$f" >&2
			missing=1
			continue
		fi
		printf '/access/%s%s\n' "$f" "$owners"
	done < <(principal_files)

	printf '\n# The guardrail path, by rule. These decide what every other file is\n'
	printf '# allowed to say, so they are not a team%s to reroute.\n' "'s"
	local p
	for p in "${guardrail_paths[@]}"; do
		printf '%s %s\n' "$p" "$guardrail_owner"
	done

	[ "$missing" -eq 0 ] || return 1
}

mode="${1:-write}"
generated="$(render)" || die "the routing is incomplete, so nothing was written"

case "$mode" in
--stdout)
	printf '%s\n' "$generated"
	;;
--check)
	if [ ! -f "$out_file" ]; then
		printf 'gen-codeowners: .github/CODEOWNERS is missing. Run: access/scripts/gen-codeowners\n' >&2
		exit 1
	fi
	if ! printf '%s\n' "$generated" | diff -u "$out_file" - >/dev/null; then
		printf 'gen-codeowners: .github/CODEOWNERS does not match the principal files.\n' >&2
		printf '%s\n' "$generated" | diff -u "$out_file" - >&2
		printf 'Run: access/scripts/gen-codeowners\n' >&2
		exit 1
	fi
	;;
write)
	mkdir -p "$(dirname "$out_file")"
	printf '%s\n' "$generated" >"$out_file"
	printf 'wrote %s\n' "${out_file#"$repo_root"/}"
	;;
*)
	echo "usage: access/scripts/gen-codeowners [--check|--stdout]" >&2
	exit 2
	;;
esac
