# Copy to .env. bin/env.sh fills the two generated keys. Nothing here is secret on a class laptop.
SECRET_KEY_BASE=
MASTER_SECRETS_KEY=
# runner support is unreleased (after v0.12.0), so this pins an immutable image from main.
# move to the next vX.Y.Z when it ships
FOUNTAIN_IMAGE_TAG=sha-7f8d16af5100e8a671039fd254543a95e728a40e
PORT=4000
FLOCI_PORT=4566
POSTGRES_PASSWORD=postgres
# runner is the default. set sprites and SPRITES_TOKEN for hosted sandboxes with egress policy
SANDBOX_PROVIDER=runner
SPRITES_TOKEN=
# written by bin/register.sh. the runner service needs it
FOUNTAIN_API_KEY=
RUNNER_NAME=waterpark
