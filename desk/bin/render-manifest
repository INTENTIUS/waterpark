#!/usr/bin/env bash
# Write desk/fountain.yaml from desk/PROMPT.md and the settings below.
#
#   desk/bin/render-manifest            write the manifest
#   desk/bin/render-manifest --check    fail if the file on disk is stale
#
# The prompt is the source. Nobody edits the system prompt inside the YAML,
# because a prompt that lives in two places is a prompt that disagrees with
# itself within a week.
set -euo pipefail

desk="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
check=false
[ "${1:-}" = "--check" ] && check=true

# What the desk's sandbox holds. The endpoint is the class stack's Floci,
# reachable by service name because the sandbox is a directory inside the
# runner container on the same compose network.
export ESTATE_REPO="${ESTATE_REPO:-https://github.com/INTENTIUS/waterpark.git}"
export ESTATE_REF="${ESTATE_REF:-main}"
export DESK_WORKSPACE="${DESK_WORKSPACE:-prod}"
export FLOCI_URL="${FLOCI_URL:-http://floci:4566}"
export DESK_MODEL="${DESK_MODEL:-anthropic/sonnet}"
export ESTATE_SLUG="${ESTATE_SLUG:-INTENTIUS/waterpark}"

python3 - "$desk" "$check" <<'PY'
import sys, pathlib, os

desk = pathlib.Path(sys.argv[1])
check = sys.argv[2] == "true"
prompt = (desk / "PROMPT.md").read_text().rstrip("\n")
indented = "\n".join(("    " + line).rstrip() for line in prompt.split("\n"))

env = {
    "ESTATE_REPO": os.environ["ESTATE_REPO"],
    "ESTATE_REF": os.environ["ESTATE_REF"],
    "ESTATE_SLUG": os.environ["ESTATE_SLUG"],
    "DESK_WORKSPACE": os.environ["DESK_WORKSPACE"],
    "AWS_ENDPOINT_URL": os.environ["FLOCI_URL"],
    "FLOCI_ENDPOINT": os.environ["FLOCI_URL"],
    "TF_VAR_floci_endpoint": os.environ["FLOCI_URL"],
    # Terraform's S3 backend reads this, which is how state reaches the
    # emulator's bucket without a backend block that names a host.
    "AWS_ENDPOINT_URL_S3": os.environ["FLOCI_URL"],
    "AWS_DEFAULT_REGION": "us-east-1",
}


def env_block(mode):
    lines = [f"    {key}: {value}" for key, value in env.items()]
    lines.append(f"    DESK_MODE: {mode}")
    return "\n".join(lines)


env_lines = env_block("direct")

manifest = f"""# The AWS desk, as Fountain objects. Generated by desk/bin/render-manifest
# from desk/PROMPT.md. Edit the prompt, not this file, then run the script.
#
#   fountain apply -f desk/fountain.yaml
#
# The vault is separate from the environment on purpose. The environment says
# where the account is, which is not a secret. The vault holds the credential
# that reaches it, and it binds to one conversation (Accessible Ops V).
apiVersion: fountain.dev/v1
kind: Environment
metadata:
  name: aws-desk-toolkit
spec:
  # The class stack's runner holds no egress policy, so a limited environment
  # is refused rather than run open. Lesson 3 is the long version.
  networking_type: unrestricted
  env_vars:
{env_lines}
---
# The same machine, told where the account is and that it may not write to it.
# One environment per mode rather than one with a switch, because a mode is a
# fact about a run and an Environment is what a run starts from.
apiVersion: fountain.dev/v1
kind: Environment
metadata:
  name: aws-desk-toolkit-repo
spec:
  networking_type: unrestricted
  env_vars:
{env_block("repo")}
---
apiVersion: fountain.dev/v1
kind: Vault
metadata:
  name: aws-desk-floci
spec:
  # Floci's throwaway pair. On a real account this is an assume-role into
  # desk-operator, bounded by the estate boundary, with the conversation id as
  # the STS source identity.
  secrets:
    AWS_ACCESS_KEY_ID: test
    AWS_SECRET_ACCESS_KEY: test
---
# Repo mode's credential. A fine-grained token with contents and pull requests
# on one repository, and nothing that reaches AWS. The Floci pair is here too,
# because a plan is a read and repo mode still plans. On a real account that
# pair is a plan-only role, and the emulator cannot express one, so the part of
# this that is a guarantee rather than a convention is live only.
#
# The token is written by hand, once, and never committed:
#   fountain vault set-secret aws-desk-github GITHUB_TOKEN <the token>
apiVersion: fountain.dev/v1
kind: Vault
metadata:
  name: aws-desk-github
spec:
  secrets:
    AWS_ACCESS_KEY_ID: test
    AWS_SECRET_ACCESS_KEY: test
---
apiVersion: fountain.dev/v1
kind: Agent
metadata:
  name: aws-desk
spec:
  model: {os.environ["DESK_MODEL"]}
  runtime: claude
  environment: aws-desk-toolkit
  description: Reads the water park estate, plans one change at a time, and applies what you approve.
  system: |
{indented}
"""

target = desk / "fountain.yaml"
if check:
    current = target.read_text() if target.exists() else ""
    if current != manifest:
        print("desk/fountain.yaml is stale. Run desk/bin/render-manifest.", file=sys.stderr)
        raise SystemExit(1)
    print("desk/fountain.yaml matches desk/PROMPT.md")
else:
    target.write_text(manifest)
    print(f"wrote {target}")
PY
