#!/usr/bin/env bash
# The satellite's deploy credential, minted on Floci.
#
#   access/scripts/mint-satellite-credential          mint it, print the key
#   access/scripts/mint-satellite-credential --env    print it as exports
#   access/scripts/mint-satellite-credential --delete remove it
#
# What this credential is allowed to do is the entire delegation contract on
# the cloud side (decision 20). It may create a role only when
# iam:PermissionsBoundary equals the central boundary ARN, and it may never
# take a boundary off. Everything else it needs is ordinary.
#
# Why a user and not a role. A satellite in the world federates through its
# own OIDC provider and assumes a deploy role, and there is no OIDC subject on
# a laptop to bind to. Floci honors trust policies, so a role trusting an
# issuer is a role nothing here can become. So an IAM user with an access key
# stands in for the satellite's deploy role, and the page says so.
#
# Decision 5 bans IAM users from the estate and the rule pack fails one in
# HCL. This one is minted by a script and deleted by the same script, and it
# is never declared. A credential that exists for the length of a proof is not
# an estate identity.
set -uo pipefail

access_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

endpoint="${FLOCI_ENDPOINT:-http://localhost:4566}"
account="${FLOCI_ACCOUNT:-000000000000}"
boundary_name="${BOUNDARY_NAME:-waterpark-estate-boundary}"
boundary_arn="arn:aws:iam::${account}:policy/${boundary_name}"

user="waterpark-runner-deploy"
policy_name="waterpark-runner-deploy"
policy_arn="arn:aws:iam::${account}:policy/${policy_name}"

root() {
	AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test \
		AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}" \
		aws --endpoint-url "$endpoint" "$@"
}

remove() {
	for k in $(root iam list-access-keys --user-name "$user" \
		--query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
		root iam delete-access-key --user-name "$user" --access-key-id "$k" >/dev/null 2>&1
	done
	root iam detach-user-policy --user-name "$user" --policy-arn "$policy_arn" >/dev/null 2>&1
	root iam delete-user --user-name "$user" >/dev/null 2>&1
	root iam delete-policy --policy-arn "$policy_arn" >/dev/null 2>&1
}

mode="${1:-mint}"

if [ "$mode" = "--delete" ]; then
	remove
	echo "removed $user and $policy_name"
	exit 0
fi

if [ "$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$endpoint/" 2>/dev/null)" = "000" ]; then
	echo "mint-satellite-credential: nothing is answering on $endpoint" >&2
	exit 1
fi

if ! root iam get-policy --policy-arn "$boundary_arn" >/dev/null 2>&1; then
	echo "mint-satellite-credential: $boundary_name is not in the account." >&2
	echo "  Central applies the boundary before a satellite can be delegated into it." >&2
	echo "  terraform -chdir=access/envs/prod apply -auto-approve" >&2
	exit 1
fi

remove

doc="$(cat <<POLICY
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyInsideTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "iam:PermissionsBoundary": "$boundary_arn" }
      }
    },
    {
      "Sid": "NeverTakeTheBoundaryOff",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TheRestOfWhatAnApplyNeeds",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteRole",
        "iam:DetachRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListEntitiesForPolicy",
        "iam:ListInstanceProfilesForRole",
        "iam:ListPolicies",
        "iam:ListPolicyVersions",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagPolicy",
        "iam:TagRole",
        "iam:UntagPolicy",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ItsOwnRegistry",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "ecr:PutImageTagMutability",
        "ecr:TagResource",
        "ecr:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
POLICY
)"

root iam create-policy --policy-name "$policy_name" --policy-document "$doc" >/dev/null || {
	echo "mint-satellite-credential: could not create $policy_name" >&2
	exit 1
}

# The deploy credential does not itself carry the estate boundary, and that is
# deliberate rather than an oversight. The estate boundary denies all IAM
# write (decision 36), so a credential inside it could not create the role the
# satellite exists to create. Its cap is the iam:PermissionsBoundary condition
# above, which is a narrower mechanism aimed at exactly one thing, the shape
# of the roles it is allowed to make. The same tension sits on the apply role
# in envs/prod, and access/README.md names it there too.
root iam create-user --user-name "$user" >/dev/null || {
	echo "mint-satellite-credential: could not create $user" >&2
	exit 1
}
root iam attach-user-policy --user-name "$user" --policy-arn "$policy_arn" >/dev/null

key_json="$(root iam create-access-key --user-name "$user")"
key_id="$(printf '%s' "$key_json" | jq -r '.AccessKey.AccessKeyId')"
key_secret="$(printf '%s' "$key_json" | jq -r '.AccessKey.SecretAccessKey')"

if [ "$mode" = "--env" ]; then
	printf 'export AWS_ACCESS_KEY_ID=%s\n' "$key_id"
	printf 'export AWS_SECRET_ACCESS_KEY=%s\n' "$key_secret"
	printf 'export AWS_DEFAULT_REGION=%s\n' "${AWS_DEFAULT_REGION:-us-east-1}"
	exit 0
fi

cat <<SUMMARY
minted $user

  iam:CreateRole                      only when iam:PermissionsBoundary equals
                                      $boundary_arn
  iam:DeleteRolePermissionsBoundary   denied outright
  the rest                            ordinary role, policy and registry calls

  AWS_ACCESS_KEY_ID      $key_id
  AWS_SECRET_ACCESS_KEY  $key_secret

Use it, then take it away.

  eval "\$(access/scripts/mint-satellite-credential --env)"
  access/scripts/mint-satellite-credential --delete

The proof this credential exists for is:

  access/scripts/double-refusal
SUMMARY
