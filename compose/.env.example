# Copy to .env. bin/env.sh fills the two generated keys. Nothing here is secret on a class laptop.
SECRET_KEY_BASE=
MASTER_SECRETS_KEY=
# runner support is unreleased (after v0.12.0), so this pins an immutable image from main.
# move to the next vX.Y.Z when it ships
FOUNTAIN_IMAGE_TAG=sha-7f8d16af5100e8a671039fd254543a95e728a40e
# Floci. the default is a patched fork build (see docker-compose.yml). FLOCI_IMAGE=floci/floci FLOCI_IMAGE_TAG=latest for upstream
FLOCI_IMAGE=ghcr.io/lex00/floci
FLOCI_IMAGE_TAG=iam-boundary
PORT=4000
FLOCI_PORT=4566
POSTGRES_PASSWORD=postgres
# runner is the default. set sprites and SPRITES_TOKEN for hosted sandboxes with egress policy
SANDBOX_PROVIDER=runner
SPRITES_TOKEN=
# sandbox lifecycle bounds. Fountain's defaults are 60 and 24. the class stack parks an idle
# sandbox after 2 minutes so Fountain lesson 2 can watch it. 0 disables a bound
SANDBOX_IDLE_TIMEOUT_MINUTES=2
SANDBOX_MAX_LIFETIME_HOURS=24
# written by bin/register.sh. the runner service needs it
FOUNTAIN_API_KEY=
RUNNER_NAME=waterpark
